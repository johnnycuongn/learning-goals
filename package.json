    "app:build": "tauri build",
    "dmg": "tauri build --bundles dmg",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fontsource/balsamiq-sans": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "dompurify": "^3.1.7",
    "marked": "^14.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.9"
  },
  "description": "Learning roadmaps researched by the AI you already pay for, kept on your own Mac."
