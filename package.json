{
  "name": "learning-goals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "icons": "node scripts/make-icons.mjs && tauri icon src-tauri/app-icon.png",
    "tauri": "tauri",
